# Variables de entorno para MyTickTick
# Copiar a .env (junto a docker-compose.prod.yml) y ajustar valores.
# docker-compose interpola ${VAR} automáticamente desde .env.
#
# Las variables con prefijo POSTGRES_* son las que lee docker-compose;
# las de prefijo DB_* las lee el binario Go (ver internal/repositories/database/database.go).
# En docker-compose.prod.yml ambas se conectan: POSTGRES_* define la DB y
# se pasan como DB_* al contenedor de la API.

## API (binario Go)
# Puerto donde escucha el binario dentro del contenedor (no confundir con API_PORT)
PORT=8080
# Puerto expuesto en el host (docker-compose)
API_PORT=8090

# Secreto HMAC para firmar tokens JWT. OBLIGATORIO en producción.
# Por defecto lo genera `make gen-secret` en ~/.myticktick/token-secret
# (fuera del repo) y `make up` lo inyecta. Solo sobrescribilo acá si querés
# otro valor: openssl rand -hex 32
#MYTICKTICK_TOKEN_SECRET=

## Base de datos (PostgreSQL)
POSTGRES_USER=myticktick
POSTGRES_PASSWORD=cambia...ucao
POSTGRES_DB=myticktick
# Puerto expuesto en el host (5432 puede estar ocupado por otra PG local)
POSTGRES_PORT=5432

## Backups (opcional, ver BACKUP.md)
# Directorio en el host donde volcar los dumps SQL
BACKUP_DIR=./backups
